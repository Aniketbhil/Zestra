# Environment Configuration
ENV=development

# Database Settings
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/zestra

# Upstash Redis Settings (TCP Endpoint with TLS via rediss://)
REDIS_URL=rediss://default:your_upstash_password@your-endpoint.upstash.io:6379

# JWT & Security Settings
JWT_SECRET=change_this_to_a_secure_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth Settings
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Frontend Settings
FRONTEND_BASE_URL=http://localhost:5173

# Gemini API Settings
GEMINI_API_KEY=your_gemini_api_key

# 2Factor API Settings
TWOFACTOR_API_KEY=your_2factor_api_key

# SMTP / Email Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com

# Razorpay Settings
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret


