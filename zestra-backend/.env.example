# Environment Configuration
ENV=development

# Database Settings
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/zestra

# Upstash Redis Settings (TCP Endpoint with TLS via rediss://)
REDIS_URL=rediss://default:your_upstash_password@your-endpoint.upstash.io:6379

# JWT & Security Settings
JWT_SECRET=change_this_to_a_secure_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
